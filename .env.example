# Copy this file to .env and fill it in. Never commit .env to git.

# Free key from https://apps.bea.gov/api/signup/ (36 characters, arrives by email)
BEA_API_KEY=paste-your-36-character-key-here

# Optional: free key from https://www.bls.gov/developers/api_signature_v2.htm
# Only needed for the optional Step 4/5 (04_fetch_bls.py / 05_compare_bls.py). Renew yearly.
BLS_API_KEY=

# How many people your spending covers (1 = just you)
HOUSEHOLD_SIZE=1

# Optional: yearly take-home pay after taxes, numbers only (e.g. 52000).
# Leave blank to skip the saving-rate comparison.
ANNUAL_TAKE_HOME=

# How to read the Amount column: auto, negative (purchases are negative), or positive
SPENDING_SIGN=auto

# Optional: only fill these if the script can't find your bank's columns
CSV_DATE_COLUMN=
CSV_DESCRIPTION_COLUMN=
CSV_AMOUNT_COLUMN=
CSV_DEBIT_COLUMN=
CSV_CREDIT_COLUMN=
CSV_CATEGORY_COLUMN=
